procedure start_running just finishes:
  let @xs: table of small_whole = [10, 20, 30]
  show position 1 of @xs
  show offset 0 of @xs
  show position 3 of @xs
  show offset 2 of @xs
  let @i: small_whole = 1
  show position (@i plus 1) of @xs
  show position 4 of @xs
  finish
end procedure start_running
